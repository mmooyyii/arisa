<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yimo.arisa</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/yimo/.local/bin/arisa-scraper</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- 要能找到 java、claude 和 arisa-scraper -->
        <key>PATH</key>
        <string>/Users/yimo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/yimo/.arisa/logs/serve.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yimo/.arisa/logs/serve.log</string>
</dict>
</plist>
